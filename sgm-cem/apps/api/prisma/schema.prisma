generator client {
  provider = "prisma-client-js"
}

// URL de connexion : prisma.config.ts (Prisma 7)
datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  DEVELOPER // niveau 6 — accès total + panneau de configuration technique (DEVELOPER_PANEL_SGM_CEM.md)
  ADMIN
  TRESORIER
  RESPONSABLE
  ADJOINT_RESPONSABLE
  COLLECTEUR
  MEMBRE
}

enum MembreCategorie {
  MCE_EN_SERVICE
  ENFANTS
  DIASPORA
}

enum MembreGroupe {
  TEMPLE
  MVOG_BETSI
  BISCUITERIE
  OBILI
  SCIENCES
  POLYTECHNIQUE
}

enum MembreStatut {
  EN_OBSERVATION
  EN_SUIVI
  FIN_DE_SUIVI
  DIASPORA
}

enum ProfilFinancier {
  TRAVAILLEUR
  ETUDIANT
  COUPLE
}

enum RubriqueType {
  REGULIERE_MENSUELLE
  PONCTUELLE
  URGENTE
}

enum RubriquePriority {
  NORMAL
  PRIORITAIRE
  URGENT
}

enum RubriqueStatut {
  OUVERTE
  FERMEE
  ARCHIVEE
}

enum ContributionStatut {
  EN_ATTENTE_CONFIRMATION
  CONFIRME
  LITIGE
  ANNULE
}

enum PaymentStatus {
  PENDING // Contribution créée, paiement pas encore initié
  PROCESSING // Demande envoyée à Yelii/CinetPay, en attente PIN/validation
  SUCCESS // Paiement confirmé par le prestataire (webhook reçu)
  FAILED // Paiement refusé ou expiré
  CANCELLED // Annulé manuellement avant confirmation
}

// Statut d'un paiement distribué entre plusieurs rubriques.
// Distinct de PaymentStatus pour préserver les statuts historiques des contributions.
enum PaymentBatchStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ModePaiement {
  ESPECES
  MTN_MOMO
  ORANGE_MONEY
  YELII
  CARTE_VISA
  VIREMENT
}

enum TransferType {
  ESPECES_EN_MAIN
  DEPOT_MTN
  DEPOT_ORANGE
  AUTRE
}

// Remboursements (lot 4.1 — M16) : demandé par le trésorier, visé par un
// administrateur ou un responsable, exécuté hors application avec preuve
enum RemboursementStatut {
  DEMANDE
  VALIDE
  EXECUTE
  REJETE
  ANNULE
}

enum RemboursementMoyen {
  ESPECES
  MOBILE_MONEY
  VIREMENT
}

// Clôture mensuelle (lot 4.2 — EF-M07-09) : présentée par le trésorier, visée
// par un administrateur ; un mois visé fige les montants de ses contributions
enum ClotureStatut {
  PRESENTEE
  VALIDEE
  REJETEE
}

enum FundsTransferStatus {
  PENDING_APPROVAL
  CONFIRMED
  REFUSED
  CANCELLED
}

enum LocalisationFonds {
  CHEZ_COLLECTEUR
  EN_TRANSIT
  CHEZ_RESPONSABLE
  REMIS_TRESORIER
  EN_CAISSE
  EN_BANQUE
  // Paiement électronique confirmé par le prestataire (Yelii, CinetPay) :
  // l'argent est sur le compte marchand, aucune personne ne le détient (décision du 17/10/2026)
  PORTEFEUILLE_ELECTRONIQUE
  // Litige résolu « annulée » : l'argent n'est plus compté dans aucun emplacement
  HORS_CIRCUIT
}

// Motif d'un mouvement du grand livre des fonds (fund_movements)
enum FundMovementReason {
  CONFIRMATION // l'argent entre dans le circuit (encaissement ou paiement confirmé)
  TRANSFERT_ENVOI
  TRANSFERT_RECEPTION
  TRANSFERT_REFUS
  TRANSFERT_ANNULATION
  DEPOT_BANCAIRE
  REPRISE_INITIALE // position constatée à la mise en service du grand livre
  ANNULATION_LITIGE // contribution confirmée puis annulée après litige : sortie du circuit
}

enum DocumentStatut {
  BROUILLON
  EN_ATTENTE
  APPROUVE
  REJETE
  ARCHIVE
}

enum PrestationStatut {
  EN_PREPARATION
  EN_COURS
  ENTREES_COMPLETES
  COMMISSION_VERSEE
  CLOTURE
}

// File des envois externes (WhatsApp/SMS, e-mail) : état et nouveaux essais
enum EnvoiCanal {
  MESSAGE // WhatsApp, puis SMS en secours
  EMAIL
}

enum EnvoiStatut {
  EN_ATTENTE // nouvel essai programmé
  EN_COURS
  ENVOYE
  ECHEC // essais épuisés ou délai dépassé
  NON_CONFIGURE // aucun canal réglé : pas de nouvel essai
}

enum NotificationStatut {
  PENDING
  SENT
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  CONFIRM
  CONFIRM_OVERRIDE // confirmation par un rôle hiérarchique supérieur au collecteur désigné (traçabilité distincte)
  REJECT
  APPROVE
  TRANSFER
  CLAIM
  TRANSFER_CONFIRMED
  TRANSFER_REFUSED
  TRANSFER_CANCELLED
  DEVELOPER_PANEL_CONFIG_CHANGED // panneau développeur — changement de config technique
  IMPERSONATE // développeur connecté en tant qu'un autre utilisateur (début/fin)
  EXPORT // export de données (Excel, données personnelles d'un membre)
  ANONYMIZE // effacement de l'identité d'une personne (montants conservés)
}

// Catégories du panneau développeur (DEVELOPER_PANEL_SGM_CEM.md §2)
enum ConfigCategory {
  WEBHOOKS // URLs de callback
  INTEGRATION_KEYS // clés API externes
  FINANCIAL // taux, commissions
  INFRASTRUCTURE // URLs de base, CORS
  SYSTEM_BEHAVIOR // délais, fréquences
  NOTIFICATIONS // sons, templates
  FEATURE_FLAGS // interrupteurs on/off
}

enum DraftStatut {
  ACTIF
  CONVERTI
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  memberId           String    @unique
  email              String    @unique
  phone              String?   @unique
  whatsappPhone      String?   @unique // E.164 ; sert à la connexion par code
  googleSub          String?   @unique // identifiant Google rattaché à la première connexion Google
  firstName          String
  lastName           String
  fullName           String
  passwordHash       String
  photoUrl           String?
  role               UserRole  @default(MEMBRE)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  notificationToken  String?
  lastLoginAt        DateTime?
  // Verrouillage après échecs de connexion par mot de passe
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  membre           Membre?
  collecteurOf     Contribution[] @relation("CollecteurContributions")
  fondsDetenus     Contribution[] @relation("ContributionDetenteur")
  createdRubriques Rubrique[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  documents        Document[]
  sessions         UserSession[]

  sentTransfers     FundsTransfer[]    @relation("FundsTransferSender")
  receivedTransfers FundsTransfer[]    @relation("FundsTransferReceiver")
  bankDeposits      BankDeposit[]      @relation("BankDepositDepositor")
  pushSubscriptions PushSubscription[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model UserSession {
  id                   String    @id @default(cuid())
  userId               String
  refreshToken         String    @unique
  expiresAt            DateTime
  createdAt            DateTime  @default(now())
  // Rotation du refresh token : l'ancien reste accepté quelques secondes
  // (onglets concurrents) ; présenté plus tard, il révèle un vol → session révoquée.
  previousRefreshToken String?
  rotatedAt            DateTime?
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([previousRefreshToken])
  @@map("user_sessions")
}

model Membre {
  id              String          @id @default(cuid())
  userId          String          @unique
  memberId        String          @unique
  categorie       MembreCategorie
  groupe          MembreGroupe
  statut          MembreStatut    @default(EN_OBSERVATION)
  profilFinancier ProfilFinancier @default(TRAVAILLEUR)
  phone           String?
  email           String?
  adresse         String?
  photoUrl        String?
  profession      String?
  dateAdhesion    DateTime        @default(now())
  dateNaissance   DateTime?
  isActive        Boolean         @default(true)
  notes           String?
  coupleId        String?
  nomConjoint     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user           User           @relation(fields: [userId], references: [id])
  contributions  Contribution[]
  paymentBatches PaymentBatch[]
  couple         Membre?        @relation("CoupleLink", fields: [coupleId], references: [id])
  coupleOf       Membre[]       @relation("CoupleLink")

  @@index([groupe])
  @@index([statut])
  @@index([categorie])
  @@map("membres")
}

model Rubrique {
  id                  String           @id @default(cuid())
  code                String           @unique
  title               String
  description         String?
  type                RubriqueType
  priority            RubriquePriority @default(NORMAL)
  status              RubriqueStatut   @default(OUVERTE)
  fiscalYear          Int
  openDate            DateTime
  closeDate           DateTime?
  amountTravailleur   Int?
  amountEtudiant      Int?
  amountCouple        Int?
  targetAmount        Int?
  targetAll           Boolean          @default(false)
  personnesConcernees String?
  isAnnualReference   Boolean          @default(false)
  createdById         String
  createdByName       String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  creator       User?          @relation(fields: [createdById], references: [id])
  contributions Contribution[]

  collectePublique CollectePublique?

  @@index([status])
  @@index([fiscalYear])
  @@index([priority])
  @@map("rubriques")
}

// ─── COLLECTE PUBLIQUE — lien de contribution ouvert sans compte ──────────────
model CollectePublique {
  id                  String   @id @default(cuid())
  rubriqueId          String   @unique // 1-1 : la Rubrique reste l'unité comptable
  publicSlug          String   @unique // ex: "collecte-toiture-2026"
  titre               String
  description         String?  @db.Text
  champsPersonnalises Json
  montantMin          Int?
  montantsSuggeres    Int[]    @default([])
  isActive            Boolean  @default(true) // contrôle l'exposition du lien public uniquement
  isUrgent            Boolean  @default(false) // signalement urgent piloté par la trésorerie ou un rôle supérieur
  createdById         String
  createdByName       String // snapshot (pattern Rubrique)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  rubrique Rubrique        @relation(fields: [rubriqueId], references: [id])
  drafts   CollecteDraft[]

  @@index([isActive])
  @@map("collectes_publiques")
}

model ContributeurExterne {
  id             String    @id @default(cuid())
  nom            String // premier nom saisi : jamais écrasé par un don suivant (EF-M08-06)
  aliases        String[]  @default([]) // autres noms saisis plus tard avec le même téléphone
  phone          String // E.164 normalisé (+237…)
  email          String?
  // Consentement explicite au traitement (loi n° 2024/017) : date et version du texte accepté
  consentAt      DateTime?
  consentVersion String?
  createdAt      DateTime  @default(now())

  contributions Contribution[]

  @@index([phone])
  @@map("contributeurs_externes")
}

model CollecteDraft {
  id             String      @id @default(cuid())
  collecteId     String
  tokenHash      String      @unique // sha256(token 32 octets) — jamais le token en clair
  nom            String?
  phone          String?
  email          String?
  montant        Int?
  valeursChamps  Json?
  statut         DraftStatut @default(ACTIF)
  contributionId String?     @unique // posé à la conversion en Contribution — sert d'anti double-clic
  expiresAt      DateTime // now + 7 j, prolongé à chaque sauvegarde
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  collecte CollectePublique @relation(fields: [collecteId], references: [id])

  @@index([phone])
  @@index([expiresAt])
  @@map("collecte_drafts")
}

model Contribution {
  id                String             @id @default(cuid())
  membreId          String?
  rubriqueId        String
  collecteurId      String?
  montant           Int
  montantAttendu    Int?
  modePaiement      ModePaiement
  statut            ContributionStatut @default(EN_ATTENTE_CONFIRMATION)
  localisationFonds LocalisationFonds  @default(CHEZ_COLLECTEUR)
  periodeLabel      String?
  referencePaiement String?
  mobileMoneyPhone  String?
  nomDonateur       String? // nom saisi pour ce don public (imprimé sur son reçu)
  momoTransactionId String?
  // Clé d'idempotence fournie par le client (saisie hors ligne rejouée) : un
  // même envoi ne crée jamais deux contributions.
  clientRequestId   String?            @unique
  note              String?            @db.Text // note libre — déclaration de remise groupée à un collecteur (pas de membreId, litigeMotif non pertinent)

  // ── Collecte publique — contributeur externe sans compte ────────────────────
  contributeurExterneId String? // XOR avec membreId — exactement l'un des deux, validé applicativement
  valeursChamps         Json? // réponses aux champs personnalisés d'une collecte publique

  // ── Champs pour les paiements en ligne (Yelii / CinetPay) ──────────────────
  // Pas @unique : un paiement réparti (PaymentBatch) partage UNE transaction
  // fournisseur entre PLUSIEURS lignes de contribution (une par rubrique) —
  // @unique interdirait d'écrire externalTransactionId sur plus d'une ligne
  // à la fois (violerait la contrainte dès le premier lot à 2+ rubriques).
  // L'index ci-dessous (@@index) suffit pour les lookups webhook/polling.
  externalTransactionId String?
  paymentStatus         PaymentStatus? @default(PENDING)
  netAmount             Int?
  paymentUrl            String?

  // Paiement multi-rubrique — nullable pour préserver toutes les contributions existantes.
  paymentBatchId String?

  // ── Commission payée par le contributeur — règle métier §1bis ──────────────
  // amountChargedToPayer = montant majoré réellement débité (montant dû + commission)
  // commissionPaidByPayer = amountChargedToPayer - montant
  // Le montant dû à la rubrique reste `montant` ; ces champs ne servent qu'à la
  // traçabilité du surcoût Mobile Money supporté par le payeur.
  amountChargedToPayer  Int?
  commissionPaidByPayer Int?

  litigeMotif               String?
  confirmedAt               DateTime?
  confirmedById             String?
  // Autorisation administrative de confirmation par un trésorier
  confirmationAuthorization Json?
  receiptUrl                String?
  receiptSentAt             DateTime?
  proofUrl                  String?
  proofUploadedAt           DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  // Transfer reference
  transferId    String?
  fundsTransfer FundsTransfer? @relation("ContributionTransfer", fields: [transferId], references: [id])

  // Dépôt bancaire (B6) — la référence de bordereau est la preuve consultable
  bankDepositId String?
  bankDeposit   BankDeposit? @relation("ContributionBankDeposit", fields: [bankDepositId], references: [id])

  // Détenteur courant de l'argent (personne) ; distinct de collecteurId, l'auteur
  // de l'encaissement, qui ne change plus. Null : banque, portefeuille, trésorerie.
  detenteurId    String?
  detenteur      User?           @relation("ContributionDetenteur", fields: [detenteurId], references: [id])
  fundMovements  FundMovement[]
  remboursements Remboursement[]

  membre              Membre?              @relation(fields: [membreId], references: [id])
  rubrique            Rubrique             @relation(fields: [rubriqueId], references: [id])
  collecteur          User?                @relation("CollecteurContributions", fields: [collecteurId], references: [id])
  contributeurExterne ContributeurExterne? @relation(fields: [contributeurExterneId], references: [id])
  paymentBatch        PaymentBatch?        @relation(fields: [paymentBatchId], references: [id], onDelete: SetNull)

  @@index([statut])
  @@index([membreId])
  @@index([rubriqueId])
  @@index([contributeurExterneId])
  @@index([externalTransactionId])
  @@index([paymentStatus])
  @@index([paymentBatchId])
  @@index([createdAt])
  @@index([detenteurId])
  @@map("contributions")
}

// ─── PAIEMENT MULTI-RUBRIQUE ─────────────────────────────────────────────────
// Un lot représente une seule transaction fournisseur répartie sur plusieurs
// contributions; les allocations conservent les lignes { rubriqueId, montant }.
model PaymentBatch {
  id                    String             @id @default(cuid())
  membreId              String?
  budget                Int
  allocations           Json
  totalAllocated        Int
  status                PaymentBatchStatus @default(PENDING)
  idempotencyKey        String             @unique
  requestFingerprint    String             @unique
  externalTransactionId String?
  paymentUrl            String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  membre        Membre?        @relation(fields: [membreId], references: [id])
  contributions Contribution[]

  @@index([membreId])
  @@index([status])
  @@index([externalTransactionId])
  @@map("payment_batches")
}

// ─── TENTATIVES DE PAIEMENT ─────────────────────────────────────────────────
// Journal de chaque demande envoyée à un prestataire. Yelii n'accepte pas de
// référence marchande : après un délai dépassé à l'initiation, seul ce journal
// (montant + numéro + date) permet de rattacher le webhook qui arrive ensuite.
enum PaymentAttemptStatus {
  INITIATING // demande en cours d'envoi
  PROCESSING // identifiant fournisseur reçu
  UNCERTAIN // réponse perdue (délai, réponse illisible) : le payeur a peut-être été débité
  FAILED // refus certain du prestataire
  LINKED // webhook orphelin rattaché après coup
}

model PaymentAttempt {
  id                    String               @id @default(cuid())
  provider              String // YELII | CINETPAY
  status                PaymentAttemptStatus @default(INITIATING)
  amount                Int // montant demandé au prestataire (majoré de la commission)
  phone                 String? // numéro normalisé 6XXXXXXXX
  channel               String?
  contributionIds       String[]
  paymentBatchId        String?
  providerTransactionId String?              @unique
  errorCode             String?
  source                String // payments_initiate | payment_batch | public_collecte
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  resolvedAt            DateTime?

  @@index([status, createdAt])
  @@index([provider, amount, phone])
  @@map("payment_attempts")
}

// ─── WEB PUSH — abonnements navigateur ────────────────────────────────────────
// Un utilisateur peut avoir plusieurs abonnements (PC + téléphone).
// endpoint est unique : re-souscrire depuis le même navigateur = upsert.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // clé publique du navigateur
  auth      String // secret d'authentification du navigateur
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("push_subscriptions")
}

// ─── B6 : DÉPÔT BANCAIRE ──────────────────────────────────────────────────────
// Chaque dépôt du trésorier en banque est enregistré avec sa référence de
// bordereau/relevé : c'est la PREUVE consultable par l'ADMIN (traçabilité).
model BankDeposit {
  id                 String    @id @default(cuid())
  referenceBordereau String // numéro de bordereau / relevé bancaire (preuve)
  dateBordereau      DateTime? // date figurant sur le bordereau
  note               String?   @db.Text
  totalAmount        Int // somme des contributions déposées
  depositedById      String
  depositedBy        User      @relation("BankDepositDepositor", fields: [depositedById], references: [id])
  depositedByName    String // snapshot du nom au moment du dépôt
  // Reçu de dépôt (fichier) : obligatoire pour tout nouveau dépôt, archivé, jamais public
  proofKey           String?
  proofBucket        String?
  proofMime          String?
  proofName          String?
  proofSize          Int?
  createdAt          DateTime  @default(now())

  contributions Contribution[] @relation("ContributionBankDeposit")

  @@index([createdAt])
  @@index([referenceBordereau])
  @@map("bank_deposits")
}

model FundsTransfer {
  id          String    @id @default(cuid())
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  refusedAt   DateTime?
  cancelledAt DateTime?

  senderId   String
  sender     User   @relation("FundsTransferSender", fields: [senderId], references: [id])
  senderName String

  receiverId   String
  receiver     User   @relation("FundsTransferReceiver", fields: [receiverId], references: [id])
  receiverName String

  totalAmount  Int
  transferType TransferType        @default(ESPECES_EN_MAIN)
  status       FundsTransferStatus @default(PENDING_APPROVAL)

  senderNote    String?
  refusalReason String?

  contributions Contribution[] @relation("ContributionTransfer")
  borderauUrl   String?

  remindersSentCount Int       @default(0)
  lastReminderSentAt DateTime?
  // Alerte « transfert non traité » envoyée à la trésorerie (une seule fois)
  tresorierAlertedAt DateTime?

  @@index([senderId])
  @@index([receiverId])
  @@index([status])
  @@index([createdAt])
  @@map("funds_transfers")
}

model Commission {
  id            String   @id @default(cuid())
  nom           String   @unique
  description   String?
  responsableId String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  documents Document[]

  @@map("commissions")
}

model TypeDocument {
  code            String     @id
  libelle         String
  retentionAnnees Int
  documents       Document[]

  @@map("type_documents")
}

model Document {
  id               String         @id @default(cuid())
  commissionId     String
  typeCode         String
  titre            String
  description      String?
  fileName         String
  fileSize         Int
  mimeType         String
  s3Key            String         @unique
  s3Bucket         String
  statut           DocumentStatut @default(BROUILLON)
  version          Int            @default(1)
  uploadedById     String
  approvedById     String?
  approvedAt       DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  rejetMotif       String?
  expiresAt        DateTime?
  // Versions (EF-M11-05) : document d'origine de la famille ; null pour la version 1
  parentId         String?
  // Conservation (EF-M11-04) : avertissement envoyé avant l'échéance
  expiryNotifiedAt DateTime?
  tags             String[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  commission   Commission   @relation(fields: [commissionId], references: [id])
  typeDocument TypeDocument @relation(fields: [typeCode], references: [code])
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])

  @@index([commissionId])
  @@index([statut])
  @@index([parentId])
  @@index([expiresAt])
  @@map("documents")
}

model Prestation {
  id                  String           @id @default(cuid())
  reference           String           @unique
  titre               String
  description         String?
  commanditaire       String
  commanditairePhone  String?
  statut              PrestationStatut @default(EN_PREPARATION)
  tarifBase           Int
  rabaisCommanditaire Int              @default(0)
  rabaisPercent       Float            @default(0)
  tarifFinal          Int
  acompte             Int              @default(0)
  solde               Int              @default(0)
  totalEntrees        Int              @default(0)
  totalCours          Int              @default(0)
  commission          Int?
  commissionPercent   Float            @default(35)
  commissionVerseeAt  DateTime?
  dateEvenement       DateTime?
  lieu                String?
  notes               String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  cours   CoursPrestation[]
  entrees EntreePrestation[]

  @@index([statut])
  @@map("prestations")
}

model CoursPrestation {
  id           String   @id @default(cuid())
  prestationId String
  libelle      String
  montant      Int
  justificatif String?
  s3Key        String?
  createdAt    DateTime @default(now())

  prestation Prestation @relation(fields: [prestationId], references: [id], onDelete: Cascade)

  @@map("cours_prestations")
}

model EntreePrestation {
  id           String       @id @default(cuid())
  prestationId String
  libelle      String
  montant      Int
  modePaiement ModePaiement
  reference    String?
  createdAt    DateTime     @default(now())

  prestation Prestation @relation(fields: [prestationId], references: [id], onDelete: Cascade)

  @@map("entrees_prestations")
}

model SystemSettings {
  id                           String   @id @default("singleton")
  defaultIncreaseRate          Float    @default(5.0)
  etudiantRatio                Float    @default(0.5)
  coupleRatio                  Float    @default(1.5)
  inactivityMonthsThreshold    Int      @default(6)
  reminderDelayDays            Int      @default(7)
  maxFundsRetentionDays        Int      @default(7)
  transferPendingReminderHours Int      @default(24)
  transferAlertTresorierHours  Int      @default(48)
  communityName                String   @default("Culte d'Enfants de Melen")
  communityVerse               String   @default("Or, à celui qui peut faire...")
  // Identité imprimée sur les documents (reçus, factures, rapports)
  communityAddress             String   @default("Église Évangélique du Cameroun, paroisse de Melen — Yaoundé, Cameroun")
  communityPhone               String?
  communityEmail               String?
  communityLegalId             String? // récépissé de déclaration, numéro d'enregistrement…
  updatedAt                    DateTime @updatedAt

  @@map("system_settings")
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  purpose   String   @default("LOGIN") // LOGIN | DRAFT_RECOVERY — empêche le rejeu d'un code entre flux
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_codes")
}

// ─── PANNEAU DÉVELOPPEUR — CONFIGURATION TECHNIQUE DYNAMIQUE ──────────────────
// La base de données est la source de vérité à l'exécution ; le .env n'est
// qu'une valeur de secours au premier démarrage (DEVELOPER_PANEL_SGM_CEM.md).
// JAMAIS ici : JWT_SECRET, REFRESH_TOKEN_SECRET, CSRF_SECRET, DATABASE_URL.

model SystemConfig {
  id          String         @id @default(cuid())
  key         String         @unique // ex: "YELII_WEBHOOK_URL"
  value       String         @db.Text // la valeur actuelle
  category    ConfigCategory // pour grouper dans l'interface
  label       String // libellé humain affiché dans l'UI
  description String?        @db.Text // aide contextuelle affichée dans l'UI
  isSecret    Boolean        @default(false) // si true → masqué dans l'UI (••••), jamais en clair
  isEditable  Boolean        @default(true) // certaines valeurs calculées ne sont pas éditables à la main
  updatedAt   DateTime       @updatedAt
  updatedBy   String? // userId du DEVELOPER qui a fait le changement

  @@index([category])
  @@map("system_configs")
}

// Historique des changements de configuration — traçabilité
model SystemConfigHistory {
  id            String   @id @default(cuid())
  configKey     String // référence à SystemConfig.key
  oldValue      String?  @db.Text
  newValue      String   @db.Text
  changedBy     String // userId du DEVELOPER
  changedByName String // snapshot du nom au moment du changement
  reason        String?  @db.Text // note optionnelle du développeur
  createdAt     DateTime @default(now())

  @@index([configKey])
  @@index([createdAt])
  @@map("system_config_history")
}

model AuditLog {
  id               String      @id @default(cuid())
  userId           String
  userName         String
  action           AuditAction
  entityType       String
  entityId         String?
  details          Json?
  ipAddress        String?
  userAgent        String?
  // Auteur réel quand l'action est faite sous impersonation (panneau développeur)
  impersonatedById String?
  createdAt        DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String             @id @default(cuid())
  userId     String
  title      String
  body       String
  type       String
  // Redirection contextuelle au clic (notifications cliquables) : targetView
  // réutilise exactement les valeurs de activeView (Sidebar/dashboard router,
  // ex. 'validations', 'transfer-validations', 'mes-contributions') pour que
  // le frontend n'ait qu'un seul gestionneur générique à maintenir — pas de
  // logique par type. targetId = id de l'entité à focus une fois sur la vue
  // (contributionId, transferId…). `data` reste pour du contexte additionnel
  // non structurel (ex: broadcast admin, montants d'une alerte).
  targetView String?
  targetId   String?
  data       Json?
  isRead     Boolean            @default(false)
  statut     NotificationStatut @default(PENDING)
  sentAt     DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─── OBSERVABILITÉ ADMINISTRATEUR ───────────────────────────────────────

model ActivitySession {
  id              String    @id @default(cuid())
  authSessionId   String    @unique
  userId          String
  authExpiresAt   DateTime
  startedAt       DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  lastActiveAt    DateTime?
  lastAccountedAt DateTime  @default(now())
  endedAt         DateTime?
  activeSeconds   Int       @default(0)

  tabs           ActivityTab[]
  pageAggregates ActivityPageAggregate[]

  @@index([userId, startedAt])
  @@index([lastSeenAt])
  @@index([endedAt, authExpiresAt])
  @@map("activity_sessions")
}

model ActivityTab {
  id         String    @id @default(cuid())
  sessionId  String
  tabId      String    @db.Uuid
  seq        Int
  pageKey    String
  isActive   Boolean
  lastSeenAt DateTime  @default(now())
  endedAt    DateTime?

  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, tabId])
  @@index([lastSeenAt])
  @@map("activity_tabs")
}

model ActivityPageAggregate {
  id            String   @id @default(cuid())
  sessionId     String
  pageKey       String
  day           DateTime @db.Date
  activeSeconds Int      @default(0)
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  session ActivitySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, pageKey, day])
  @@index([day, pageKey])
  @@map("activity_page_aggregates")
}

// Grand livre des fonds : AJOUT SEUL. Chaque changement d'emplacement de l'argent
// y est écrit dans la même transaction que la mise à jour de la contribution ;
// la position à une date se reconstitue à partir de ces lignes.
model FundMovement {
  id             String             @id @default(cuid())
  contributionId String
  montant        Int
  fromLocation   LocalisationFonds?
  toLocation     LocalisationFonds
  holderFromId   String?
  holderToId     String?
  reason         FundMovementReason
  transferId     String?
  bankDepositId  String?
  actorId        String?
  at             DateTime           @default(now())

  contribution Contribution @relation(fields: [contributionId], references: [id])

  @@index([contributionId, at])
  @@index([at])
  @@map("fund_movements")
}

// Écriture compensatoire d'une contribution confirmée (EF-M16-01/02) : la
// contribution d'origine n'est jamais modifiée ; les totaux déduisent les
// remboursements exécutés. rubriqueId et membreId sont recopiés pour les totaux.
model Remboursement {
  id              String              @id @default(cuid())
  contributionId  String
  contribution    Contribution        @relation(fields: [contributionId], references: [id])
  rubriqueId      String
  membreId        String?
  montant         Int
  moyen           RemboursementMoyen
  motif           String              @db.Text
  beneficiaire    String? // à qui l'argent est rendu (nom, numéro)
  statut          RemboursementStatut @default(DEMANDE)
  requestedById   String
  requestedByName String
  requestedAt     DateTime            @default(now())
  validatedById   String?
  validatedByName String?
  validatedAt     DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  executedById    String?
  executedByName  String?
  executedAt      DateTime?
  // Emplacement d'où l'argent est sorti (caisse, portefeuille électronique, banque…)
  sourceLocation  LocalisationFonds?
  reference       String? // référence de l'opération (transaction Mobile Money, virement)
  proofKey        String?
  proofBucket     String?
  proofMime       String?
  proofName       String?
  proofSize       Int?

  @@index([contributionId])
  @@index([statut])
  @@index([rubriqueId])
  @@index([executedAt])
  @@map("remboursements")
}

// Clôture d'un mois : position des fonds au dernier jour (instantané), montants
// comptés et écarts justifiés. Le déclencheur contributions_mois_clos (migration)
// refuse toute modification de montant ou suppression dans un mois VALIDEE.
model ClotureMensuelle {
  id                  String        @id @default(cuid())
  annee               Int
  mois                Int
  statut              ClotureStatut @default(PRESENTEE)
  positionFin         Json
  totalEncaisse       Int
  totalRembourse      Int
  nbContributions     Int
  attenduCaisse       Int
  attenduBanque       Int
  attenduPortefeuille Int
  caisseComptee       Int
  soldeBancaire       Int
  soldePortefeuille   Int
  justification       String?       @db.Text
  presentedById       String
  presentedByName     String
  presentedAt         DateTime      @default(now())
  validatedById       String?
  validatedByName     String?
  validatedAt         DateTime?
  rejectedById        String?
  rejectedAt          DateTime?
  rejectionReason     String?

  @@unique([annee, mois])
  @@map("clotures_mensuelles")
}

model Envoi {
  id             String      @id @default(cuid())
  canal          EnvoiCanal
  objet          String // code de connexion, paiement confirmé, relevé…
  destinataire   String // téléphone ou e-mail (purgé avec les journaux d'envoi, 1 an)
  payload        Json
  statut         EnvoiStatut @default(EN_ATTENTE)
  essais         Int         @default(0)
  voie           String? // WHATSAPP, SMS ou EMAIL : canal qui a abouti
  derniereErreur String?
  prochainEssai  DateTime?
  expireLe       DateTime? // au-delà, plus de nouvel essai (code de connexion)
  envoyeLe       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([statut, prochainEssai])
  @@index([createdAt])
  @@map("envois")
}

// ── Suivi d'erreurs (point 17) ──────────────────────────────────────────
enum IncidentSource {
  TACHE // tâche planifiée
  WEBHOOK // notification d'un prestataire de paiement
  ENVOI // WhatsApp, SMS ou e-mail abandonné
}

// Incident technique regroupé : une même erreur répétée incrémente le compteur.
// Le message est expurgé (ni téléphone, ni e-mail, ni jeton).
model Incident {
  id           String         @id @default(cuid())
  source       IncidentSource
  code         String // nom de la tâche, prestataire ou objet de l'envoi
  message      String
  occurrences  Int            @default(1)
  premiereFois DateTime       @default(now())
  derniereFois DateTime       @default(now())
  resoluLe     DateTime?
  resoluPar    String?

  @@index([resoluLe, derniereFois])
  @@index([source, code])
  @@map("incidents")
}

// Dernière exécution de chaque tâche planifiée (santé du système)
model TacheEtat {
  nom            String    @id
  dernierDebut   DateTime?
  dernierSucces  DateTime?
  derniereErreur DateTime?
  erreur         String?
  resultat       String?
  dureeMs        Int?

  @@map("taches_etat")
}
