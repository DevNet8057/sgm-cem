{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "^5.22.0",
    "@sgm-cem/shared": "workspace:*",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "1.4.5-lts.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.6.1",
    "pg": "latest",
    "puppeteer": "^21.11.0",
    "socket.io": "^4.8.4",
    "twilio": "^6.3.1",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
