{
  "name": "sgm-cem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:shared && cross-env HOST=0.0.0.0 node scripts/dev.mjs",
    "build:shared": "pnpm --filter @sgm-cem/shared build",
    "build": "pnpm build:shared && pnpm --filter api build && pnpm --filter web build",
    "postinstall": "pnpm build:shared",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22.12"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "brace-expansion@1": "^1.1.20",
      "brace-expansion@2": "^2.1.7",
      "browserslist": "^4.28.7",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "engine.io": "^6.6.10",
      "socket.io-parser": "^4.2.7",
      "body-parser@1": "^1.20.6",
      "qs": "^6.16.0",
      "uuid@8": "^11.1.1",
      "brace-expansion@5": "^5.0.12"
    }
  }
}
