{
  "name": "sgm-cem",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm build:shared && cross-env HOST=0.0.0.0 node scripts/dev.mjs",
    "build:shared": "pnpm --filter @sgm-cem/shared build",
    "build": "pnpm build:shared && pnpm --filter api build && pnpm --filter web build",
    "postinstall": "pnpm build:shared",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "fast-xml-parser@>=4.0.0 <4.5.5": "4.5.5",
      "tar-fs@>=3.0.0 <3.1.1": "3.1.1",
      "ws@>=8.0.0 <8.21.0": "8.23.0",
      "brace-expansion@>=1.0.0 <1.1.20": "1.1.20",
      "postcss@>=8.0.0 <8.5.18": "8.5.33",
      "browserslist@>=4.0.0 <4.28.7": "4.28.7"
    }
  }
}
