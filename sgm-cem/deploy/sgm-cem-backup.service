[Unit]
Description=SGM-CEM - sauvegarde PostgreSQL et fichiers
Requires=docker.service
After=docker.service sgm-cem.service

[Service]
Type=oneshot
WorkingDirectory=/srv/sgm-cem/sgm-cem
ExecStart=/srv/sgm-cem/sgm-cem/deploy/backup.sh
Environment=TZ=Africa/Douala
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=1800
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/sgm-cem
