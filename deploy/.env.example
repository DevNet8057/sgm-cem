# /opt/sgm-cem/.env — PRODUCTION (mode 600, jamais versionné). Détail : doc 03 § 6.1
APP_DOMAIN=app.exemple.cm
ACME_EMAIL=admin@exemple.cm
APP_URL=https://app.exemple.cm
API_URL=https://app.exemple.cm

IMAGE_API=ghcr.io/devnet8057/sgm-cem-api@sha256:<empreinte-publiée-par-la-CI>
IMAGE_WEB=ghcr.io/devnet8057/sgm-cem-web@sha256:<empreinte-publiée-par-la-CI>

POSTGRES_USER=sgm_app
POSTGRES_PASSWORD=<openssl rand -hex 24>
POSTGRES_DB=sgm_cem
DATABASE_URL=postgresql://sgm_app:<POSTGRES_PASSWORD>@postgres:5432/sgm_cem?schema=public&connection_limit=10
REDIS_PASSWORD=<openssl rand -hex 24>
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379

# ≥ 32 caractères, tous différents (l'API refuse de démarrer sinon)
JWT_SECRET=<openssl rand -base64 48>
REFRESH_TOKEN_SECRET=<openssl rand -base64 48>
CSRF_SECRET=<openssl rand -base64 48>
# Chiffre les secrets d'intégration en base — à conserver aussi dans le coffre (perdue = clés à ressaisir)
CONFIG_ENCRYPTION_KEY=<openssl rand -base64 48>
TRUST_PROXY=1

# Premier démarrage : laisser ADMIN_PASSWORD vide (mot de passe aléatoire affiché
# une fois dans `docker compose logs api`, changement imposé à la 1re connexion)
ADMIN_EMAIL=admin@exemple.cm
ADMIN_PASSWORD=
SEED_DEMO=0

LOG_LEVEL=info
# Suivi d'erreurs (Sentry ou GlitchTip compatible) — facultatif
SENTRY_DSN=

# Heure de Yaoundé (aussi fixée dans docker-compose.prod.yml pour web, api et worker)
TZ=Africa/Douala

# ── Intégrations : à saisir de préférence dans le panneau développeur ─────────
# Elles y sont chiffrées en base (CONFIG_ENCRYPTION_KEY) et modifiables sans
# redémarrage ; une valeur ici ne sert que de secours. Liste complète et défauts :
# sgm-cem/.env.example et docs/reference/DEVELOPER_PANEL_SGM_CEM.md
# Paiements : webhooks à déclarer chez le prestataire
#   Yelii    : ${API_URL}/webhooks/yelii      CinetPay : ${API_URL}/webhooks/cinetpay
# YELII_COLLECT_API_KEY=
# YELII_WEBHOOK_SECRET=
# CINETPAY_API_KEY=
# CINETPAY_SITE_ID=
# CINETPAY_SECRET_KEY=
# Messages : WhatsApp (360dialog), SMS de secours (Twilio), e-mail (SMTP)
# DIALOG360_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Notifications push : npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@exemple.cm
# Contact affiché sur « Mot de passe oublié »
# SUPPORT_CONTACT_EMAIL=
# SUPPORT_CONTACT_PHONE=
# Connexion Google : ID client OAuth (aussi NEXT_PUBLIC_GOOGLE_CLIENT_ID au build de l'image web)
# GOOGLE_CLIENT_ID=

# ── Fichiers (images, preuves, GED) : stockage objet S3 compatible ────────────
# Vide : fichiers sur le disque du serveur (volume uploads, sauvegardé par backup.sh).
# Deux buckets : public (reçus, photos) et PRIVÉ (GED, preuves de dépôt et de remboursement).
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET_NAME=sgm-cem-public
# S3_PRIVATE_BUCKET_NAME=sgm-cem-prive
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=

# Version affichée dans « Santé du système » (renseignée au déploiement)
APP_VERSION=
